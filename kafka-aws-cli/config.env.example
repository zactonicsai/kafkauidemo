# Copy to config.env and edit. Sourced by every script.
PROJECT="kafka-stack"
REGION="us-east-1"
DOMAIN="example.com"                 # a domain you own
VPC_CIDR="10.0.0.0/16"

# Stage 02 - Keycloak
KEYCLOAK_INSTANCE_TYPE="t3.small"
KEYCLOAK_ADMIN_PASSWORD="change-me-admin"
KEYCLOAK_CLIENT_SECRET="change-me-long-random-secret"
ALICE_PASSWORD="change-me-alice"
BOB_PASSWORD="change-me-bob"

# Stage 03 - Kafka + Kafka UI
KAFKA_INSTANCE_TYPE="t3.medium"
KAFKA_ROOT_VOLUME_GB="30"
