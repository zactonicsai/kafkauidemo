#!/bin/bash
set -euxo pipefail

# Save bootstrap output in a normal file as well as cloud-init output.
exec > >(tee -a /var/log/kafka-keycloak-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

STACK_DIR="/opt/kafka-keycloak"
COMPOSE_VERSION="v5.1.4"

mkdir -p "$STACK_DIR"

###############################################################################
# 1. INSTALL AND START DOCKER
###############################################################################

# Amazon Linux 2023 includes Docker in its normal package repositories.
dnf install -y docker curl

# Make Docker start now and after every EC2 reboot.
systemctl enable docker
systemctl start docker

# Allow the normal Amazon Linux user to run Docker after the next login.
usermod -aG docker ec2-user

# Fail the bootstrap if the Docker daemon never becomes ready.
for i in {1..30}; do
  if docker info >/dev/null 2>&1; then
    echo "Docker is running."
    break
  fi

  echo "Waiting for Docker... attempt $i/30"
  sleep 2
done

docker info >/dev/null
systemctl is-enabled docker
systemctl is-active docker

###############################################################################
# 2. MAKE SURE SSM IS RUNNING
###############################################################################

systemctl enable --now amazon-ssm-agent || true

###############################################################################
# 3. INSTALL DOCKER COMPOSE PLUGIN
###############################################################################

mkdir -p /usr/local/lib/docker/cli-plugins

curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose

chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

docker compose version

###############################################################################
# 4. WRITE THE COMPOSE / KEYCLOAK / KAFKA UI CONFIG FILES
###############################################################################

# Terraform base64-encodes these files before inserting them into user-data.
# That avoids shell quoting problems with JSON and YAML.
echo '${docker_compose_b64}' | base64 -d > "$STACK_DIR/docker-compose.yml"
echo '${keycloak_realm_b64}' | base64 -d > "$STACK_DIR/keycloak-realm.json"
echo '${kafka_ui_config_b64}' | base64 -d > "$STACK_DIR/kafka-ui.yml"

chmod 600 "$STACK_DIR/keycloak-realm.json" "$STACK_DIR/kafka-ui.yml"
chmod 644 "$STACK_DIR/docker-compose.yml"

cd "$STACK_DIR"

docker compose config

###############################################################################
# 5. DOWNLOAD AND START THE CONTAINERS
###############################################################################

docker compose pull

# A small systemd service makes Compose start after Docker on every EC2 boot.
cat > /etc/systemd/system/kafka-keycloak-compose.service <<SERVICE
[Unit]
Description=Kafka Keycloak Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$STACK_DIR
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable kafka-keycloak-compose.service
systemctl start kafka-keycloak-compose.service

###############################################################################
# 6. VERIFY DOCKER AND THE STACK
###############################################################################

systemctl is-active docker
systemctl is-active kafka-keycloak-compose.service

docker compose ps
docker ps

echo "Bootstrap complete."
