#!/bin/bash
set -euxo pipefail

exec > >(tee -a /var/log/kafka-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

STACK_DIR="/opt/kafka-stack"
COMPOSE_VERSION="v5.1.4"
mkdir -p "$STACK_DIR"

# Amazon Linux 2023 normally already has curl-minimal. Do not install full curl.
dnf install -y docker
if ! command -v curl >/dev/null 2>&1; then
  dnf install -y curl-minimal
fi

systemctl enable --now docker
systemctl enable --now amazon-ssm-agent || true
usermod -aG docker ec2-user

for i in {1..30}; do
  docker info >/dev/null 2>&1 && break
  sleep 2
done
docker info >/dev/null

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

echo '${docker_compose_b64}' | base64 -d > "$STACK_DIR/docker-compose.yml"
echo '${kafka_ui_config_b64}' | base64 -d > "$STACK_DIR/kafka-ui.yml"
chmod 644 "$STACK_DIR/docker-compose.yml"
# Kafka UI runs as a non-root user in the container. The bind-mounted file
# must therefore be readable by that user. 0644 is intentional for this lab.
chmod 644 "$STACK_DIR/kafka-ui.yml"

cd "$STACK_DIR"
docker compose config
docker compose pull

cat > /etc/systemd/system/kafka-compose.service <<SERVICE
[Unit]
Description=Kafka and Kafka UI Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$STACK_DIR
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now kafka-compose.service

sleep 15
docker compose ps
docker compose logs --tail=100 || true

echo "Kafka host bootstrap complete."
