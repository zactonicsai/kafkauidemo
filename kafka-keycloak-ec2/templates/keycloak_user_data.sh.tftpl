#!/bin/bash
set -euxo pipefail

exec > >(tee -a /var/log/keycloak-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

STACK_DIR="/opt/keycloak-stack"
KEYCLOAK_DATA_DIR="$STACK_DIR/keycloak-data"
COMPOSE_VERSION="v5.1.4"

mkdir -p "$STACK_DIR" "$KEYCLOAK_DATA_DIR/h2"

# The official Keycloak container runs as UID 1000 and GID 0.
# Give that runtime user ownership of the persistent H2 directory.
chown -R 1000:0 "$KEYCLOAK_DATA_DIR"
chmod -R u+rwX,g+rwX "$KEYCLOAK_DATA_DIR"

# Amazon Linux 2023 normally already has curl-minimal. Do not install full curl.
dnf install -y docker
if ! command -v curl >/dev/null 2>&1; then
  dnf install -y curl-minimal
fi

systemctl enable --now docker
systemctl enable --now amazon-ssm-agent || true
usermod -aG docker ec2-user

for i in {1..30}; do
  docker info >/dev/null 2>&1 && break
  sleep 2
done
docker info >/dev/null

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL \
  "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

echo '${keycloak_compose_b64}' | base64 -d > "$STACK_DIR/docker-compose.yml"
echo '${keycloak_realm_b64}' | base64 -d > "$STACK_DIR/keycloak-realm.json"
chmod 644 "$STACK_DIR/docker-compose.yml"

# Keycloak runs as UID 1000, so it must be able to read the realm import file.
chown 1000:0 "$STACK_DIR/keycloak-realm.json"
chmod 640 "$STACK_DIR/keycloak-realm.json"
python3 -m json.tool "$STACK_DIR/keycloak-realm.json" >/dev/null

cd "$STACK_DIR"
docker compose config
docker compose pull

cat > /etc/systemd/system/keycloak-compose.service <<SERVICE
[Unit]
Description=Keycloak Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$STACK_DIR
# Re-assert ownership before every Compose startup in case files were restored or copied.
ExecStartPre=/usr/bin/chown -R 1000:0 $KEYCLOAK_DATA_DIR
ExecStartPre=/usr/bin/chmod -R u+rwX,g+rwX $KEYCLOAK_DATA_DIR
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now keycloak-compose.service

# Keycloak can take a little while on first boot.
for i in {1..60}; do
  if curl -fsS "http://127.0.0.1:8081/realms/kafka-ui/.well-known/openid-configuration" >/dev/null 2>&1; then
    echo "Keycloak realm is ready."
    break
  fi
  sleep 2
done

docker compose ps
docker compose logs --tail=100 || true

echo "Keycloak host bootstrap complete."
