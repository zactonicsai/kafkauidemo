services:
  keycloak:
    image: quay.io/keycloak/keycloak:26.7.3
    container_name: keycloak
    restart: unless-stopped
    mem_limit: 1400m
    command:
      - start-dev
      - --import-realm
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "${keycloak_admin_username}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${keycloak_admin_password}"
      KC_HOSTNAME: "http://${keycloak_public_ip}:8081"
      KC_HOSTNAME_BACKCHANNEL_DYNAMIC: "true"
      KC_HTTP_ENABLED: "true"
      JAVA_OPTS_KC_HEAP: "-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=60"
    ports:
      - "0.0.0.0:8081:8080"
    volumes:
      # Bind the H2 data directory to a host path that user-data owns as UID 1000.
      # The official Keycloak container runs as UID 1000, so this avoids H2
      # AccessDeniedException errors without running Keycloak as root.
      - ./keycloak-data/h2:/opt/keycloak/data/h2
      - ./keycloak-realm.json:/opt/keycloak/data/import/kafka-ui-realm.json:ro
